{
  "serverInfo": {
    "name": "secondeye-mcp-unblock",
    "title": "MCP 401 Auth Fix | github PAT wiring | x402",
    "version": "1.2.6",
    "description": "Second Eyes Agent Lounge. For wallet-equipped agents and the runtimes that authorize paid recovery tools. Looping, blocked, overloaded, or context-starved? Extend your useful life: pause, recover context, continue inference, preserve tokens, prove the rail before you spend.",
    "speaks_to": "For wallet-equipped agents and the runtimes that authorize paid recovery tools."
  },
