{
  "version": "2026-05-27",
  "description": "Restored base validator policy keys clobbered by first seed apply.",
  "source_validation": {
    "require_fetchable_source": true,
    "require_scope_match": true,
    "scope_terms": [
      "ai",
      "ux",
      "ui",
      "user interface",
      "user experience",
      "design",
      "wireframe",
      "prototype",
      "figma",
      "canva",
      "framer",
      "webflow",
      "cursor",
      "lovable",
      "replit",
      "uizard",
      "galileo",
      "relume",
      "design-to-code",
      "accessibility",
      "usability",
      "design system"
    ]
  },
  "creative_waistline": {
    "min_content_length": 400,
    "min_sentence_count": 6,
    "min_sentence_rhythm_variance": 3,
    "max_robotic_language_hits": 1,
    "require_niche_specificity": true,
    "robot_phrases": [
      "in today's fast-paced world",
      "in the ever-evolving landscape",
      "game-changer",
      "revolutionize the way",
      "it is important to note",
      "delve into",
      "unlock the power",
      "seamlessly",
      "robust solution",
      "elevate",
      "unleash",
      "next-gen"
    ]
  },
  "learning_rule": {
    "mode": "human_feedback_changes_validator_grading_stance",
    "probabilistic_model_write_authority": false,
    "trickle_down": "future probabilistic outputs are shaped by what validator policy accepts and rejects"
  }
}
