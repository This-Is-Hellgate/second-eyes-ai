{
  "version": "2026-05-27",
  "description": "Merged into validator_policy.policy on seed apply.",
  "synthesis": {
    "cadence_hours": 6,
    "require_citations": true,
    "require_opinion_label": true,
    "min_sources_per_cluster": 2,
    "max_sources_per_cluster": 4,
    "artifact_formats": [
      "reel",
      "reaction_video",
      "howto_ux_ui",
      "wireframe_pro",
      "planning_pro",
      "podcast_dialogue",
      "cited_opinion_blog"
    ],
    "format_selection": "relationship_traversal",
    "cluster_query": "SELECT suitable_for relationships from SourceArtifact entities with approved signals",
    "stage_gates": {
      "hermes_propose": "adaptive_only",
      "script_validate": "deterministic_schema",
      "stage2_render": "metadata_fidelity_check",
      "human_gate": "finished_product_only",
      "publish": "space3_only_after_approval"
    }
  },
  "beat_templates": {
    "reel": { "duration_sec": 45, "beats": 4, "citation_density": "high" },
    "reaction_video": { "duration_sec": 180, "beats": 6, "citation_density": "high" },
    "howto_ux_ui": { "duration_sec": 300, "beats": 8, "citation_density": "medium" },
    "wireframe_pro": { "duration_sec": 240, "beats": 7, "citation_density": "medium" },
    "planning_pro": { "duration_sec": 240, "beats": 7, "citation_density": "medium" },
    "podcast_dialogue": { "duration_sec": 600, "speakers": 2, "citation_density": "high" },
    "cited_opinion_blog": { "word_target": 1200, "sections": 5, "citation_density": "required_per_claim" }
  }
}
