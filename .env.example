# Copy to .env.local (never commit). Then: node scripts/push-coinbase-secrets.mjs

# Coinbase CDP — portal.cdp.coinbase.com → API Keys → Secret API key
CDP_API_KEY_NAME=organizations/YOUR_ORG/apiKeys/YOUR_KEY_ID
CDP_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# Base wallet that receives USDC from agent payments
X402_PAYTO=0xYourBaseWalletAddress

# Fixed for CDP mainnet facilitator
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform

# Random 64-char hex — scripts/push-coinbase-secrets.mjs generates if omitted
ACCESS_TOKEN_SECRET=

# OpenRouter — transcribe + extract doors (google/gemini-3.1-flash-lite)
OPENROUTER_API_KEY=

# External-payer monitoring — operator/test wallets to EXCLUDE from the
# external_buyer_signal. Comma/space/newline-separated 0x addresses. Defaults
# already cover the canary payer + lounge payTo; add CI/test wallets here.
# Set KNOWN_TEST_PAYERS_STRICT=1 to ignore the built-in defaults entirely.
KNOWN_TEST_PAYERS=
# KNOWN_TEST_PAYERS_STRICT=
