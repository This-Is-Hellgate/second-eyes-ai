# Copy to .env.local (never commit). Then: node scripts/push-coinbase-secrets.mjs

# Coinbase CDP — portal.cdp.coinbase.com → API Keys → Secret API key
CDP_API_KEY_NAME=organizations/YOUR_ORG/apiKeys/YOUR_KEY_ID
CDP_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# Base wallet that receives USDC from agent payments
X402_PAYTO=0xYourBaseWalletAddress

# Fixed for CDP mainnet facilitator
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform

# --- Multi-network x402 (optional, opt-in) — see docs/multi-network-x402.md ---
# Base (eip155:8453) is always the canonical accepts[0]. Extra rails append to
# accepts[] ONLY when configured + gated below. Default = Base only (no change).
#
# Polygon (eip155:137): same EVM merchant wallet + CDP EIP-712 verify/settle path
# as Base. Low-risk opt-in. Set to 1 to advertise + accept Polygon USDC.
# X402_POLYGON_ENABLED=
# Optional dedicated Polygon merchant wallet (defaults to X402_PAYTO when unset):
# X402_POLYGON_PAY_TO=0xYourPolygonWalletAddress
#
# Solana (solana:…): SPL USDC, base58 mint, non-EIP-712 signing. DOUBLE-GATED and
# OFF by default. Advertised only as "planned" until BOTH vars are set AND you have
# confirmed the CDP Solana facilitator settles on our request shape. Supply a real
# Solana address — never reuse the EVM 0x wallet, never guess.
# X402_SOLANA_PAY_TO=YourSolanaUsdcReceiveAddressBase58
# X402_SOLANA_ACTIVE=

# Random 64-char hex — scripts/push-coinbase-secrets.mjs generates if omitted
ACCESS_TOKEN_SECRET=

# OpenRouter — transcribe + extract doors (google/gemini-3.1-flash-lite)
OPENROUTER_API_KEY=

# External-payer monitoring — operator/test wallets to EXCLUDE from the
# external_buyer_signal. Comma/space/newline-separated 0x addresses. Defaults
# already cover the canary payer + lounge payTo; add CI/test wallets here.
# Set KNOWN_TEST_PAYERS_STRICT=1 to ignore the built-in defaults entirely.
KNOWN_TEST_PAYERS=
# KNOWN_TEST_PAYERS_STRICT=
