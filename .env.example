# Copy to .env.local (never commit). Then: node scripts/push-coinbase-secrets.mjs

# Coinbase CDP — portal.cdp.coinbase.com → API Keys → Secret API key
CDP_API_KEY_NAME=organizations/YOUR_ORG/apiKeys/YOUR_KEY_ID
CDP_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# Base wallet that receives USDC from agent payments
X402_PAYTO=0xYourBaseWalletAddress

# Fixed for CDP mainnet facilitator
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform

# --- Multi-network x402 (optional, opt-in) — see docs/multi-network-x402.md ---
# Base (eip155:8453) is always the canonical accepts[0]. Extra rails append to
# accepts[] ONLY when configured + gated below. Default = Base only (no change).
#
# Polygon (eip155:137): same EVM merchant wallet + CDP EIP-712 verify/settle path
# as Base. Low-risk opt-in. Set to 1 to advertise + accept Polygon USDC.
# X402_POLYGON_ENABLED=
# Optional dedicated Polygon merchant wallet (defaults to X402_PAYTO when unset):
# X402_POLYGON_PAY_TO=0xYourPolygonWalletAddress
#
# Solana (solana:…): SPL USDC, base58 mint, non-EIP-712 signing. DOUBLE-GATED and
# OFF by default. Advertised only as "planned" until BOTH vars are set AND you have
# confirmed the CDP Solana facilitator settles on our request shape. Supply a real
# Solana address — never reuse the EVM 0x wallet, never guess.
# X402_SOLANA_PAY_TO=YourSolanaUsdcReceiveAddressBase58
# X402_SOLANA_ACTIVE=

# Random 64-char hex — scripts/push-coinbase-secrets.mjs generates if omitted
ACCESS_TOKEN_SECRET=

# OpenRouter — transcribe + extract doors (google/gemini-3.1-flash-lite)
OPENROUTER_API_KEY=

# External-payer monitoring — operator/test wallets to EXCLUDE from the
# external_buyer_signal. Comma/space/newline-separated 0x addresses. Defaults
# already cover the canary payer + lounge payTo; add CI/test wallets here.
# Set KNOWN_TEST_PAYERS_STRICT=1 to ignore the built-in defaults entirely.
KNOWN_TEST_PAYERS=
# KNOWN_TEST_PAYERS_STRICT=

# --- x402 facilitator integration test harness (test/x402-facilitator/) ---
# Layers 1-2 need NOTHING here. These gate Layer 3 (live testnet settlement) and
# the dry-run reachability probes. Testnet wallets ONLY — never reuse production
# X402_PAYTO / X402_SOLANA_PAY_TO / CDP keys. See docs/x402-facilitator-testing.md.
# Dry-run (Layer 2) facilitator URLs — no spend:
# TEST_FACILITATOR_URL_BASE_SEPOLIA=https://api.cdp.coinbase.com/platform/v2/x402
# TEST_FACILITATOR_URL_POLYGON_AMOY=https://x402-amoy.polygon.technology
# TEST_FACILITATOR_URL_SOLANA_DEVNET=https://api.cdp.coinbase.com/platform/v2/x402
# Live settlement (Layer 3) — triple-gated, default OFF, $5 hard cap:
# RUN_X402_SETTLEMENT_TESTS=          # must equal "1" to spend
# MAX_TEST_SPEND_USD=0.05             # per-run cap (default 0.25, ceiling 5)
# ALLOW_MAINNET_SETTLEMENT=           # must equal "I_UNDERSTAND" for a mainnet URL
# TEST_EVM_PRIVATE_KEY=0x...          # testnet only; MUST differ from production key
# TEST_EVM_PAY_TO=0x...               # MUST differ from X402_PAYTO / X402_POLYGON_PAY_TO
# TEST_SOLANA_SECRET_KEY=...          # base58 testnet payer
# TEST_SOLANA_PAY_TO=...              # MUST differ from X402_SOLANA_PAY_TO
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# --- Polygon canary (scripts/polygon-canary.mjs) — gated MAINNET spend ---
# Repo-native low-cap Polygon canary. Default OFF; spends real Polygon USDC only when
# every gate is set. Use a LOW-BALANCE THROWAWAY key — Gate 7 aborts a hot wallet.
# See docs/polygon-canary.md. CI runs the mock gates only (POLYGON_CANARY_MOCK=1).
# RUN_POLYGON_CANARY=                 # must equal "1" to spend
# POLYGON_CANARY_PRIVATE_KEY=0x...    # low-balance throwaway payer; NEVER the treasury
# POLYGON_CANARY_EXPECTED_PAYTO=0x... # production Polygon merchant payTo (must match built accept)
# POLYGON_CANARY_EXPECTED_AMOUNT_USD=0.01
# POLYGON_CANARY_MAX_USD=0.05         # per-run ceiling (default 0.05, hard cap 1)
# POLYGON_CANARY_MAX_WALLET_USDC=5    # abort if canary wallet holds more USDC than this
# POLYGON_CANARY_EXPECTED_ASSET=      # defaults to canonical Polygon USDC
# POLYGON_CANARY_EXPECTED_NETWORK=eip155:137
# POLYGON_CANARY_RPC_URL=https://polygon-rpc.com   # balance-read RPC override
# POLYGON_CANARY_MOCK=                # "1" = exercise gates offline, no spend (CI)
